{
  "name": "textgame",
  "version": "0.1.0",
  "description": "修仙 CLI 文字 RPG — 基于 LLM 的修仙题材互动文字游戏",
  "type": "module",
  "bin": {
    "textgame": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck && pnpm run lint",
    "check:fix": "pnpm run typecheck && pnpm run lint:fix && pnpm run format",
    "spellcheck": "cspell \"**/*.ts\" \"**/*.md\"",
    "prepare": "husky",
    "release": "release-it",
    "release:beta": "release-it --preRelease=beta --ci",
    "release:dry": "release-it --dry-run --ci",
    "release:patch": "release-it patch --ci",
    "release:minor": "release-it minor --ci",
    "release:major": "release-it major --ci"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.30.3",
  "keywords": [
    "game",
    "cultivation",
    "rpg",
    "cli",
    "llm",
    "text-game"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shenjingnan/textgame.git"
  },
  "dependencies": {
    "@mariozechner/pi-ai": "^0.65.0",
    "@mariozechner/pi-tui": "^0.65.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@release-it/conventional-changelog": "^11.0.0",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^3.2.0",
    "cspell": "^10.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "release-it": "^20.2.0",
    "tsdown": "^0.21.7",
    "tsx": "^4.19.0",
    "typescript": "^6.0.2",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "overrides": {
      "basic-ftp": ">=5.3.0",
      "undici": ">=6.24.0"
    }
  }
}
